# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection used by the API container.
DB_URL=jdbc:postgresql://db:5432/climaservice
DB_USERNAME=climaservice_user
DB_PASSWORD=change-me

# Credentials for the db service itself (docker-compose.yml).
POSTGRES_DB=climaservice
POSTGRES_USER=climaservice_user
POSTGRES_PASSWORD=change-me

# Base64-encoded HMAC secret used to sign JWTs. Generate your own, e.g.:
#   openssl rand -base64 32
JWT_SECRET=change-me-base64-secret

# Comma-separated list of allowed CORS origins (the Angular frontend, in
# production). Optional — defaults to http://localhost:4200 if unset.
CORS_ALLOWED_ORIGINS=http://localhost:4200
